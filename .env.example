# ==========================================
# MyMemo Environment Configuration
# ==========================================

# 1. DATABASE CONFIGURATION
# Untuk Localhost:
DATABASE_URL="file:../../data/app.db"

# Untuk Deploy Vercel (Turso Cloud Database):
# TURSO_DATABASE_URL="libsql://your-database-name-username.turso.io"
# TURSO_AUTH_TOKEN="ey..."

# 2. GEMINI AI CONFIGURATION (Langsung berjalan di Next.js)
LLM_API_KEY="your-gemini-api-key"
LLM_MODEL="gemini-2.5-flash"

# 3. KEEPALIVE CRON SECRET (Opsional untuk keamanan GitHub Action keepalive)
# CRON_SECRET="your-random-keepalive-secret"
